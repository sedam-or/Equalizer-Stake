  "db_name": "PostgreSQL",
  "query": "WITH candidates AS ( SELECT id FROM public.jobs WHERE status = 'queued' AND run_at <= $1 AND (tenant_id IS NULL OR tenant_id = ANY($2)) ORDER BY run_at, id FOR UPDATE SKIP LOCKED LIMIT $3 ) UPDATE public.jobs AS job SET status = 'running', locked_until = $1 + make_interval(secs => $4::double precision), attempts = job.attempts + 1 FROM candidates WHERE job.id = candidates.id RETURNING job.id, job.tenant_id, job.kind, job.payload, job.attempts, job.max_attempts",
