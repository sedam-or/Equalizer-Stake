  "db_name": "PostgreSQL",
  "query": "WITH aggregate_heads AS MATERIALIZED ( SELECT DISTINCT ON (tenant_id, aggregate_id) id FROM public.outbox WHERE dispatched_at IS NULL AND aggregate_id IS NOT NULL ORDER BY tenant_id, aggregate_id, id ) SELECT candidate.id, candidate.tenant_id, candidate.event_type, candidate.aggregate_id, candidate.payload, candidate.occurred_at FROM public.outbox AS candidate WHERE candidate.dispatched_at IS NULL AND (candidate.aggregate_id IS NULL OR candidate.id IN ( SELECT id FROM aggregate_heads )) ORDER BY candidate.id LIMIT $1 FOR UPDATE OF candidate SKIP LOCKED",
