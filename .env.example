# Equalizer-Stake Production Environment Variables
# Copy to .env.prod and fill in values

# Database
POSTGRES_DB=equalizer_stake
POSTGRES_USER=eqs_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Backend
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
CORS_ORIGINS=https://yourdomain.com
BACKEND_PORT=8000
BACKEND_REPLICAS=1

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
FRONTEND_PORT=3000

# WhatsApp Gateway (optional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# SMTP Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
