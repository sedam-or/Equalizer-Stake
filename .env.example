# Local development only. Copy to .env; never use these values outside a local checkout.
DATABASE_URL=postgres://eq_app:eq_app@localhost:5433/ritma # App connection; eq_app is NOSUPERUSER/NOBYPASSRLS.
RITMA_DATABASE_OWNER_URL=postgres://eq:eq@localhost:5433/ritma # Migrations only; never run the server with this URL.
RITMA_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= # Fake 32-byte development key; generate a unique key for every install.
RITMA_PUBLIC_URL=http://localhost:8080 # Required in local development.

# Optional: previous key during a local key rotation (fake development value).
# RITMA_SECRET_KEY_PREVIOUS=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# RITMA_MODE defaults to single; use multi only when the task requires multi-tenant mode.
RITMA_MODE=single
RITMA_LISTEN=0.0.0.0:8080
RITMA_DATA_DIR=./data
RITMA_FILES_BACKEND=local
# Optional one-time setup token; never reuse this test-secret-* placeholder.
# RITMA_SETUP_TOKEN=test-secret-local-setup-token
# Optional trusted proxy CIDRs; the default allows loopback proxies only.
# RITMA_TRUSTED_PROXIES=127.0.0.1/32
RITMA_LOG=info
RITMA_LOG_FORMAT=pretty
RITMA_BACKUP_SCHEDULE=off
RITMA_BACKUP_KEEP=14
# Optional local fake SMTP endpoint.
# RITMA_SMTP_URL=smtp://test:test-secret-local-smtp@localhost:1025
# CAPTCHA settings are optional and must be configured together; these are fake local values.
# RITMA_CAPTCHA_PROVIDER=turnstile
# RITMA_CAPTCHA_SITE_KEY=test-site-key
# RITMA_CAPTCHA_SECRET=test-secret-local-captcha
RITMA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
RITMA_TELEMETRY=off
RITMA_UPDATE_CHECK=on
# Optional metrics token; never reuse this test-secret-* placeholder.
# RITMA_METRICS_TOKEN=test-secret-local-metrics
RITMA_DB_POOL=10
RITMA_DEMO=false
