#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! -f "$1" ]]; then
  echo "usage: commit-msg <message-file>" >&2
  exit 2
fi

header="$(head -n 1 "$1")"
case "$header" in
  "fixup! "*|"squash! "*|"Merge "*) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|test|docs|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [A-Za-z0-9].{0,70}$'
if (( ${#header} > 72 )); then
  echo "commit header is longer than 72 characters" >&2
  exit 1
fi
if [[ ! "$header" =~ $pattern ]]; then
  echo "commit header must follow COMMIT_CONVENTION.md" >&2
  exit 1
fi
