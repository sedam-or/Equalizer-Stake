# App
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=equalizer_stake
POSTGRES_USER=eqs
POSTGRES_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Reservation
RESERVATION_TTL_MINUTES=15
BUFFER_TIME_MINUTES=15
