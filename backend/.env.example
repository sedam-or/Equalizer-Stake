# Equalizer-Stake — Backend
# Copy this to .env and fill in values

# Database
POSTGRES_DB=equalizer_stake
POSTGRES_USER=eqs_admin
POSTGRES_PASSWORD=eqs_dev_password

# Backend
DATABASE_URL=postgresql+asyncpg://eqs_admin:eqs_dev_password@localhost:5432/equalizer_stake
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# WhatsApp Gateway (unofficial)
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_KEY=your-api-key-here

# Email SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@bmdmusik.id
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@bmdmusik.id

# Studio GPS coordinates
STUDIO_LAT=-7.7265
STUDIO_LNG=110.4162
STUDIO_GPS_RADIUS=150

# Attendance
FACE_DETECTION_THRESHOLD=0.30
